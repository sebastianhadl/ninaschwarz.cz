---
// Projects overview — served at /projects/ and /cs/projects/.
import Photo from '../../../components/Photo.astro';
import { displayTitle, projectImages, projects } from '../../../data/projects';
import { langPaths, localizedPath, useTranslations, type Lang } from '../../../i18n';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} path="/projects/" title={t.meta.projectsTitle} description={t.meta.projectsDescription}>
  <section class="plist theme-dark">
    <h1 class="eyebrow plist__label">{t.projects.heading}</h1>

    <ul class="plist__items">
      {
        projects.map((project, i) => {
          const { cover } = projectImages(project.slug);
          return (
            <li class="plist__item">
              <a class="plist__link" href={localizedPath(lang, `/projects/${project.slug}/`)}>
                <span class="plist__image">
                  <Photo src={cover} widths={[640, 960, 1280, 1600, 2000, 2500]} sizes="100vw" alt="" eager={i === 0} />
                </span>
                <span class="plist__num" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="plist__title" set:html={displayTitle(project.title)} />
                <span class="plist__meta">
                  {t.projects.kind[project.kind]} · {project.released}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<style>
  .plist {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 3rem) var(--pad) clamp(3rem, 8vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .plist__label {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--gold);
  }

  .plist__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding-block: clamp(0.25rem, 0.8vw, 0.75rem);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .plist__item:first-child .plist__link {
    border-top: 1px solid var(--line);
  }

  .plist__num,
  .plist__meta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.4s var(--ease);
  }

  .plist__title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, min(12vw, 16.5svh), 11.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s var(--ease);
  }

  .plist__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Pointer devices: each project's photo fills the whole page behind the list
     while its title is hovered or focused. */
  @media (hover: hover) and (min-width: 52rem) {
    .plist__image {
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0;
      transition: opacity 0.7s var(--ease);
    }

    .plist__image::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(11, 11, 12, 0.78), rgba(11, 11, 12, 0.3));
    }

    .plist__image :global(img) {
      transform: scale(1.06);
      transition: transform 1.6s var(--ease-out);
    }

    .plist__link:hover .plist__image,
    .plist__link:focus-visible .plist__image {
      opacity: 1;
    }

    .plist__link:hover .plist__image :global(img),
    .plist__link:focus-visible .plist__image :global(img) {
      transform: none;
    }

    /* Nothing hovered yet: show the first project so the page never opens on plain black. */
    .plist:not(:has(.plist__link:hover, .plist__link:focus-visible)) .plist__item:first-child .plist__image {
      opacity: 0.55;
    }

    .plist:has(.plist__link:hover, .plist__link:focus-visible) .plist__link:not(:hover, :focus-visible) .plist__title {
      opacity: 0.35;
    }

    .plist__link:hover .plist__title,
    .plist__link:focus-visible .plist__title {
      font-style: italic;
      transform: translateX(clamp(0.5rem, 2vw, 2rem));
    }

    .plist__link:hover .plist__num,
    .plist__link:hover .plist__meta,
    .plist__link:focus-visible .plist__num,
    .plist__link:focus-visible .plist__meta {
      color: var(--gold);
    }
  }

  /* Touch screens and narrow windows: every project is a card with its own photo. */
  @media not ((hover: hover) and (min-width: 52rem)) {
    .plist {
      justify-content: flex-start;
    }

    .plist__items {
      display: grid;
      gap: 0.75rem;
    }

    .plist__link {
      position: relative;
      grid-template-columns: 1fr auto;
      align-items: end;
      min-height: clamp(11rem, 44vw, 20rem);
      padding: 1.1rem;
      border: 0 !important;
      border-radius: 2px;
      overflow: hidden;
      isolation: isolate;
    }

    .plist__image {
      position: absolute;
      inset: 0;
      z-index: -1;
    }

    .plist__image::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(11, 11, 12, 0.8), rgba(11, 11, 12, 0.05) 65%);
    }

    .plist__num {
      display: none;
    }

    .plist__title {
      font-size: clamp(3rem, 14vw, 6rem);
      line-height: 0.9;
    }

    .plist__meta {
      color: var(--gold);
    }
  }
</style>
