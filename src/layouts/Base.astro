---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifLatinItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import serifExt from '@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-normal.woff2?url';
import serifExtItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-italic.woff2?url';
import sansLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import sansExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';

import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { languages, routePath, useTranslations, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** English path of this page, e.g. `/` or `/projects/yellow/`. */
  path: string;
  title: string;
  description: string;
  /** Absolute or root-relative image for link previews. */
  image?: string;
  /** Extra schema.org data for this page. */
  schema?: Record<string, unknown>[];
  /** Set to false for utility pages such as the 404. */
  index?: boolean;
}

const { lang, path, title, description, image, schema = [], index = true } = Astro.props;
const t = useTranslations(lang);

// Canonical addresses always point at the real domain, even on a preview deployment.
const canonical = new URL(routePath(lang, path), site.url).href;
const alternates = languages.map((code) => ({ code, href: new URL(routePath(code, path), site.url).href }));
const deployedAt = Astro.site ?? new URL(site.url);
const isProduction = deployedAt.hostname === new URL(site.url).hostname;
const ogImage = new URL(image ?? withBase('/og-image.jpg'), deployedAt).href;

// Czech pages need the extended Latin range (ě, š, č, ř, ž, ů …) straight away.
const preloads =
  lang === 'cs'
    ? [serifLatin, serifLatinItalic, serifExt, serifExtItalic, sansLatin, sansExt]
    : [serifLatin, serifLatinItalic, sansLatin];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#nina`,
  name: site.name,
  url: site.url,
  image: new URL(withBase('/og-image.jpg'), deployedAt).href,
  jobTitle: ['Singer', 'Dancer', 'Actor', 'Songwriter'],
  email: `mailto:${site.email}`,
  telephone: site.phone.display,
  address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
  nationality: { '@type': 'Country', name: 'Czech Republic' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'The American Musical and Dramatic Academy' },
    { '@type': 'CollegeOrUniversity', name: 'Prague Conservatory' },
  ],
  sameAs: site.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="format-detection" content="telephone=no" />
    {(!isProduction || !index) && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    {preloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      languages
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={useTranslations(code).ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[person, ...schema].map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <slot name="head" />
  </head>

  <body class="theme-light">
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} path={path} />

    <main id="main">
      <slot />
    </main>

    <Contact lang={lang} />
    <Footer lang={lang} path={path} />
    <Lightbox lang={lang} />

    <script>
      // Reveal elements as they scroll into view.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
