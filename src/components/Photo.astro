---
// One place that decides how photos are delivered: AVIF first, WebP for older
// browsers, a handful of sizes for the browser to pick from, lazy by default.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { widthsFor } from '../utils/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Candidate widths in pixels; ones larger than the file are dropped. */
  widths: number[];
  /** How wide the photo is shown, e.g. `(min-width: 52rem) 50vw, 100vw`. */
  sizes: string;
  /** Load straight away (use for the first image on a page only). */
  eager?: boolean;
}

const { src, alt, widths, sizes, eager = false } = Astro.props;
const usable = widthsFor(src, widths);
// The plain `src` is only used by browsers without srcset support — keep it modest.
const fallback = usable.find((w) => w >= 960) ?? usable[usable.length - 1];
---

<Picture
  src={src}
  formats={['avif']}
  fallbackFormat="webp"
  widths={usable}
  width={fallback}
  sizes={sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
