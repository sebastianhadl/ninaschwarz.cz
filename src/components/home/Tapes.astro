---
// Performance tapes — the list itself is in src/data/home.ts.
import Player from '../Player.astro';
import { tapes } from '../../data/home';
import { typo, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="tapes theme-dark section" id="tapes">
  <div class="container">
    <h2 class="display tapes__heading" data-reveal set:html={typo(lang, t.tapes.heading)} />

    <div class="tapes__grid">
      {
        tapes.map((tape, i) => (
          <figure class="tape" data-reveal style={`--reveal-delay:${i}`}>
            <Player
              source={{ type: 'file', src: tape.src }}
              poster={tape.poster}
              title={t.tapes.items[i]?.title ?? `${t.tapes.play} ${i + 1}`}
              alt={t.tapes.items[i]?.alt ?? ''}
              playLabel={t.tapes.play}
            />
            <figcaption>
              <span class="tape__title">{t.tapes.items[i]?.title ?? `0${i + 1}`}</span>
              <span class="tape__time">{tape.duration}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tapes__heading {
    max-width: 12em;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .tapes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .tape figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .tape__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .tape__time {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
    color: var(--gold);
  }

  @media (max-width: 52rem) {
    .tapes__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
