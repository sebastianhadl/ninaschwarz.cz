---
import { getImage } from 'astro:assets';
import heroWide from '../../assets/images/home/hero.jpg';
import heroTall from '../../assets/images/home/hero-portrait.jpg';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

// Two crops of the same portrait: the full landscape frame for wide screens and a
// tighter upright one for phones, so small screens don't download pixels they crop away.
const wideWidths = [960, 1280, 1600, 2000, 2500];
const tallWidths = [480, 720, 960, 1250];
const wideAvif = await getImage({ src: heroWide, format: 'avif', widths: wideWidths, width: 2500 });
const wideWebp = await getImage({ src: heroWide, format: 'webp', widths: wideWidths, width: 1600 });
const tallAvif = await getImage({ src: heroTall, format: 'avif', widths: tallWidths, width: 1250 });
const tallWebp = await getImage({ src: heroTall, format: 'webp', widths: tallWidths, width: 1250 });

// These mirror the sizing in the styles below.
const portrait = '(max-aspect-ratio: 4/5)';
const tallSizes = '81vh';
const wideSizes = '162vh';
---

<section class="hero theme-dark">
  <picture class="hero__media">
    <source media={portrait} type="image/avif" srcset={tallAvif.srcSet.attribute} sizes={tallSizes} />
    <source media={portrait} type="image/webp" srcset={tallWebp.srcSet.attribute} sizes={tallSizes} />
    <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideSizes} />
    <img
      src={wideWebp.src}
      srcset={wideWebp.srcSet.attribute}
      sizes={wideSizes}
      width={heroWide.width}
      height={heroWide.height}
      alt={t.hero.imageAlt}
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero__content">
    <p class="hero__tagline">
      {
        t.hero.tagline.map((word, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{word}</span>
          </>
        ))
      }
    </p>
    <h1 class="hero__name">
      <span class="hero__word"><span>Nina</span></span>
      <span class="hero__word hero__word--italic"><span>Schwarz</span></span>
    </h1>
  </div>
</section>

<style>
  .hero {
    /* Everything in the hero is sized from its height, so the face and the
       name keep the same relationship on every screen shape. */
    --hero-h: max(100svh, 34rem);
    --photo-ratio: 1.5; /* width ÷ height of the photo in use */
    --photo-h: calc(var(--hero-h) * 1.08);
    /* exactly the backdrop colour of the photo, so its edges disappear */
    --bg: #1a1a1a;

    position: relative;
    display: grid;
    align-items: end;
    height: var(--hero-h);
    overflow: hidden;
  }

  .hero__media {
    display: block;
    position: absolute;
    inset: 0;
    animation: hero-settle 2.6s var(--ease-out) both;
  }

  /* The photo is placed by hand rather than with object-fit: her chin (70% down
     the photo) always sits at 63.5% of the hero's height, which leaves the lower
     third free for the name. The photo's own background is black, so where it
     doesn't reach the edges of the screen it simply fades out. */
  .hero__media img {
    position: absolute;
    left: 50%;
    top: calc(var(--hero-h) * 0.635 - var(--photo-h) * 0.7);
    width: calc(var(--photo-h) * var(--photo-ratio));
    max-width: none;
    height: var(--photo-h);
    translate: -50% 0;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to top, transparent, #000 16%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to top, transparent, #000 16%);
    mask-composite: intersect;
  }

  /* Darken the foot of the photo so the name always reads. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(to top, rgba(11, 11, 12, 0.82), rgba(11, 11, 12, 0));
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: 0 var(--pad) clamp(0.75rem, 2vw, 1.75rem);
  }

  .hero__tagline {
    display: flex;
    align-items: center;
    gap: 0.85em;
    margin-bottom: clamp(0.25rem, 1vw, 0.75rem);
    font-size: clamp(0.6875rem, 0.6rem + 0.35vw, 0.9375rem);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    animation: hero-fade 1.2s var(--ease-out) 0.9s both;
  }

  .hero__tagline::before {
    content: '';
    width: clamp(1.5rem, 4vw, 3.5rem);
    height: 1px;
    background: currentColor;
  }

  .hero__name {
    display: flex;
    justify-content: center;
    gap: 0.2em;
    font-family: var(--font-display);
    font-weight: 400;
    /* wide enough to run edge to edge, but never taller than the space under the face */
    font-size: min(19.6vw, var(--hero-h) * 0.345);
    line-height: 0.82;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  /* Each word slides up from behind a mask. The padding leaves room for the
     italic overhang so the mask doesn't shave the letters. */
  .hero__word {
    display: block;
    overflow: hidden;
    padding: 0.06em 0.07em 0.1em;
    margin: -0.06em -0.07em -0.1em;
  }

  .hero__word > span {
    display: block;
    animation: hero-rise 1.4s var(--ease-out) 0.2s both;
  }

  .hero__word--italic {
    font-style: italic;
  }

  .hero__word--italic > span {
    animation-delay: 0.34s;
  }

  @keyframes hero-rise {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: scale(1.07);
    }
  }

  /* Phones and other upright screens: the name stacks on two lines. */
  @media (max-aspect-ratio: 4/5) {
    .hero {
      --photo-ratio: 0.75;
    }

    .hero__content {
      padding-bottom: clamp(1.25rem, 5vw, 2.5rem);
    }

    .hero__name {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      font-size: min(30.5vw, var(--hero-h) * 0.155);
      line-height: 0.84;
    }

    .hero__tagline {
      margin-bottom: 0.9rem;
    }
  }
</style>
