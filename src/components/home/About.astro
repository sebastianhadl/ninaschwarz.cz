---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import portrait from '../../assets/images/home/about.jpg';
import { site } from '../../data/site';
import { typo, useTranslations, withBase, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="about theme-light section" id="about">
  <div class="container about__grid">
    <div class="about__media">
      <div class="about__frame" data-reveal>
        <Photo
          src={portrait}
          widths={[400, 640, 960, 1200, 1600]}
          sizes="(min-width: 60rem) 38vw, 92vw"
          alt={t.about.imageAlt}
        />
      </div>
    </div>

    <div class="about__body">
      <h2 class="display about__heading" data-reveal set:html={typo(lang, t.about.heading)} />

      <div class="about__text">
        {t.about.paragraphs.map((paragraph) => <p data-reveal set:html={typo(lang, paragraph)} />)}
      </div>

      <div class="about__facts" data-reveal>
        <h3 class="eyebrow">{t.about.highlightsLabel}</h3>
        <dl>
          {
            t.about.highlights.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd set:html={typo(lang, item.text)} />
              </div>
            ))
          }
        </dl>
      </div>

      <a class="btn about__cta" href={withBase(site.resume)} target="_blank" rel="noopener" data-reveal>
        {t.about.cta}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .about__media {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .about__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
  }

  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  .about__heading {
    margin-bottom: clamp(1.75rem, 4vw, 3.5rem);
  }

  .about__text {
    display: grid;
    gap: 1.35em;
    max-width: 40em;
  }

  .about__text p:first-child {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: -0.005em;
  }

  .about__text :global(strong) {
    font-weight: 700;
  }

  .about__facts {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .about__facts dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 1.5rem;
  }

  .about__facts dt {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.3vw, 2.15rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .about__facts dt::before {
    content: '✦';
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--gold);
  }

  .about__facts dd {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .about__cta {
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  @media (max-width: 60rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__media {
      position: static;
      max-width: 34rem;
    }
  }

  @media (max-width: 30rem) {
    .about__facts dl {
      grid-template-columns: 1fr;
    }
  }
</style>
