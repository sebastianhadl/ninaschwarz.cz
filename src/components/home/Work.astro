---
// "see more of my work" — the music projects, straight on the home page.
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { displayTitle, projectImages, projects } from '../../data/projects';
import { localizedPath, typo, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="work theme-dark section" id="work">
  <div class="container">
    <div class="work__head">
      <h2 class="display" data-reveal set:html={typo(lang, t.work.heading)} />
      <a class="btn work__all" href={localizedPath(lang, '/projects/')} data-reveal>
        {t.work.cta}
        <Icon name="arrow-right" />
      </a>
    </div>

    <ul class="work__grid">
      {
        projects.map((project, i) => {
          const { cover } = projectImages(project.slug);
          return (
            <li data-reveal style={`--reveal-delay:${i % 2}`}>
              <a class="card" href={localizedPath(lang, `/projects/${project.slug}/`)}>
                <Photo src={cover} widths={[480, 720, 960, 1400, 1800]} sizes="(min-width: 52rem) 46vw, 92vw" alt="" />
                <span class="card__body">
                  <span class="card__meta">
                    {t.projects.kind[project.kind]} · {project.released}
                  </span>
                  <span class="card__title" set:html={displayTitle(project.title)} />
                </span>
                <span class="card__arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .work__head h2 {
    max-width: 9em;
  }

  .work__all:hover :global(svg) {
    transform: translateX(0.25em);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--ink-soft);
    color: var(--paper);
    text-decoration: none;
    isolation: isolate;
  }

  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.4s var(--ease-out),
      filter 0.6s var(--ease);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 11, 12, 0.85), rgba(11, 11, 12, 0.25) 45%, rgba(11, 11, 12, 0) 70%);
    transition: opacity 0.5s var(--ease);
  }

  .card__body {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.1rem, 2.4vw, 2.25rem);
  }

  .card__meta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(247, 245, 240, 0.85);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .card__arrow {
    position: absolute;
    top: clamp(1rem, 2vw, 1.75rem);
    right: clamp(1rem, 2vw, 1.75rem);
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 4vw, 3.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
    opacity: 0;
    transform: translate(-0.5rem, 0.5rem) scale(0.9);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease-out);
  }

  .card__arrow :global(svg) {
    width: 40%;
    height: 40%;
  }

  .card:hover :global(img),
  .card:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .card:hover .card__arrow,
  .card:focus-visible .card__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 52rem) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: none) {
    .card__arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
