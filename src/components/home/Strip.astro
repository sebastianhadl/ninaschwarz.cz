---
// Three full-bleed portraits, edge to edge.
import Photo from '../Photo.astro';
import one from '../../assets/images/home/strip-1.jpg';
import two from '../../assets/images/home/strip-2.jpg';
import three from '../../assets/images/home/strip-3.jpg';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const images = [one, two, three];
---

<div class="strip">
  {
    images.map((image, i) => (
      <div class="strip__cell">
        <Photo src={image} widths={[320, 480, 640, 960, 1280]} sizes="33.4vw" alt={t.strip.alts[i]} />
      </div>
    ))
  }
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--paper-deep);
  }

  .strip__cell {
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .strip__cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Photos ease out of a slight zoom as they scroll into view (where supported). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .strip__cell :global(img) {
        animation: strip-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 55%;
      }

      @keyframes strip-settle {
        from {
          transform: scale(1.2);
        }
        to {
          transform: scale(1);
        }
      }
    }
  }
</style>
